# What this app is signed and shipped as. Sourced by every script under Scripts/ that builds, signs, wraps or
# publishes a build. Holds no secret: the notary credentials live in the keychain under $NOTARY_PROFILE, and
# the private key of the signing identity lives in the keychain too.

# The Wooflab team. Its Developer ID Application certificate is what lets a downloaded copy open without the
# owner having to clear it in System Settings; only the team's Account Holder can create that certificate.
TEAM_ID=85F6AC5QZF
NOTARY_PROFILE=wooflab-notary

APP_NAME=SnappySnap
BUNDLE_ID=dev.rubens.SnappySnap
GITHUB_REPO=bambidotexe/snappy-snap
# The colour the last chevron of the disk image backdrop is drawn in: the red of the icon.
DMG_ACCENT="#D23C36"

# The certificate's common name carries the team's registered name, which is Apple's to spell, not ours. The
# team identifier is the part we know, so the identity is looked up by it rather than written out here.
# Empty when the certificate is not in this keychain: the scripts that need it say so themselves, and the
# ones that only wrap or name a build carry on without it.
SIGN_IDENTITY="${SIGN_IDENTITY:-$(/usr/bin/security find-identity -v -p codesigning \
  | /usr/bin/grep "Developer ID Application" | /usr/bin/grep "($TEAM_ID)" \
  | /usr/bin/head -1 | /usr/bin/sed -E 's/.*"(.*)".*/\1/' || true)}"
